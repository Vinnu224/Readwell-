drop policy if exists "Allow all" on students;
drop policy if exists "Allow all" on progress;

drop table if exists progress;
drop table if exists students;

create table students (
  name text primary key,
  last_seen timestamptz default now()
);

create table progress (
  id bigint generated always as identity primary key,
  student_name text references students(name) on delete cascade,
  passage_id int not null,
  quiz_score int,
  quiz_total int,
  read_seconds int,
  practice_results jsonb,
  updated_at timestamptz default now(),
  unique (student_name, passage_id)
);

alter table students enable row level security;
alter table progress enable row level security;

create policy "Allow all" on students for all using (true) with check (true);
create policy "Allow all" on progress for all using (true) with check (true);
